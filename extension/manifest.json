{
  "manifest_version": 3,
  "name": "BOSS直聘 · 定向自动沟通助手",
  "version": "1.5.1",
  "description": "求职端自动沟通：按关键词/屏蔽词/屏蔽公司筛选岗位，逐个进详情点立即沟通，在聊天页自动填写自定义招呼语并回车发送，返回初始筛选列表继续；整页投完再翻页、投过自动去重、配置本地保存。",
  "author": "doubao",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.zhipin.com/*",
        "*://*.zhipin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}